# ============================================================
# HPE SALES GUARDIAN (OBELISK) — VARIABLES DE ENTORNO
# Copia este archivo como .env y completa los valores
# ============================================================

# ── REQUERIDO: Groq (gratis, 14,400 req/día) ────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Obtener en: https://console.groq.com/keys

# ── RECOMENDADO: SerpAPI (100 búsquedas/mes gratis) ─────────
# Si no lo configuras, usará DuckDuckGo automáticamente
SERP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Obtener en: https://serpapi.com/manage-api-key

# ── OPCIONAL: Qdrant (RAG con PDFs de HPE) ───────────────────
# Solo si quieres alimentar el sistema con documentos internos
# QDRANT_URL=https://xxxxx.aws.cloud.qdrant.io
# QDRANT_API_KEY=xxxxxxxxxxxxxxxxxxxxx
